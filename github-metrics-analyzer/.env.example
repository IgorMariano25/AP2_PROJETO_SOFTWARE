GITHUB_TOKEN=ghp_cole_seu_token_aqui
SONAR_HOST_URL=http://localhost:9000
# IMPORTANTE: gere um "User Token" (My Account > Security), NAO um
# "Global Analysis Token" — o coletor le metricas via Web API e o global
# analysis token nao tem permissao de leitura (403 Insufficient privileges).
SONAR_TOKEN=cole_seu_user_token_do_sonarqube_aqui
# Versao do Python reportada ao analyzer (silencia o warning "compatible with
# all Python 3 versions"). Default 3.12 — igual ao TOOLS_VERSIONS.md.
# SONAR_PYTHON_VERSION=3.12

# --- Caminhos de ferramentas externas (opcional) ---
# Por padrao os scripts procuram no PATH e na pasta developer-tools/ do projeto.
# Use estas variaveis so para apontar um binario fora desses locais.
# DEVELOPER_TOOLS=E:\outro\caminho\developer-tools
# CODEQL_CLI=...\developer-tools\codeql\codeql.exe
# SONARSCANNER_CLI=...\developer-tools\sonar-scanner\bin\sonar-scanner.bat
# GITLEAKS_CLI=...\developer-tools\gitleaks\gitleaks.exe
# CODEQL_SUITE=java-security-extended.qls
