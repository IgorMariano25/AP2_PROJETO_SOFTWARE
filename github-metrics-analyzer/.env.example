# Copie este arquivo para ".env" e preencha com o seu token.
# O arquivo ".env" esta no .gitignore e NUNCA deve ser commitado.
#
# Gere um token em: https://github.com/settings/tokens
# Escopo minimo recomendado: "public_repo" (apenas leitura de repos publicos).

GITHUB_TOKEN=ghp_cole_seu_token_aqui

# --- SonarQube (fase "sonarqube"; metricas estruturais canonicas) ---
# Suba o servidor:  docker run -d -p 9000:9000 sonarqube:community
# Gere o token em:  My Account > Security > Generate Tokens
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=cole_seu_token_do_sonarqube_aqui

# --- Caminhos de ferramentas externas (opcional) ---
# Por padrao os scripts procuram no PATH e em E:\developer-tools\<ferramenta>.
# Use estas variaveis so para apontar um binario fora desses locais.
# DEVELOPER_TOOLS=E:\developer-tools
# CODEQL_CLI=E:\developer-tools\codeql\codeql.exe
# SONARSCANNER_CLI=E:\developer-tools\sonar-scanner\bin\sonar-scanner.bat
# GITLEAKS_CLI=E:\developer-tools\gitleaks\gitleaks.exe
# CODEQL_SUITE=java-security-extended.qls
