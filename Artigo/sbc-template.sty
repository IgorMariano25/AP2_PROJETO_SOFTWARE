% SBC-compatible LaTeX style for article submissions.
% Place this file next to main.tex when compiling outside the official SBC
% Overleaf template.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2026/06/14 SBC-compatible article template]

\RequirePackage{times}
\RequirePackage{natbib}

% Page layout used by the SBC article template on A4 paper.
\setlength{\paperwidth}{21cm}
\setlength{\paperheight}{29.7cm}
\setlength{\textwidth}{16cm}
\setlength{\textheight}{24.7cm}
\setlength{\oddsidemargin}{0cm}
\setlength{\evensidemargin}{0cm}
\setlength{\topmargin}{-1cm}
\setlength{\headheight}{0cm}
\setlength{\headsep}{0cm}
\setlength{\footskip}{1cm}

\pagestyle{empty}

\makeatletter

\newcommand{\inst}[1]{\unskip$^{#1}$}
\newcommand{\email}[1]{\texttt{#1}}
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\nextinstitute}{\\[0.6em]}
\gdef\@address{}

\def\@maketitle{%
  \newpage
  \null
  \vskip -1.5em%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.5em%
    {\normalsize\bfseries
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 0.5em%
    {\normalsize
      \begin{tabular}[t]{c}%
        \@address
      \end{tabular}\par}%
  \end{center}%
  \par
  \vskip 1.5em%
}

\renewenvironment{abstract}{%
  \begin{quotation}
  \noindent\textbf{Abstract.}\ \ignorespaces
}{%
  \end{quotation}
}

\newenvironment{resumo}{%
  \begin{quotation}
  \noindent\textbf{Resumo.}\ \ignorespaces
}{%
  \end{quotation}
}

% SBC references are commonly authored with parenthetical \cite and textual
% \citeonline commands.
\setcitestyle{authoryear,round,semicolon,aysep={,},yysep={;}}
\let\cite\citep
\@ifundefined{citeonline}{\let\citeonline\citet}{}

\makeatother

